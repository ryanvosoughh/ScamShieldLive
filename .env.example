# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is git-ignored; never commit real keys.

# --- Mode -------------------------------------------------------------
# true  = demo mode: plays scripted calls (grandchild scam, bank scam, normal
#         call), needs no keys. With GROQ_API_KEY set, the real scam check
#         runs on the scripted words; without it, scripted verdicts are used.
# false = live mode: real microphone + Deepgram transcription. Demo calls can
#         still be started from the page.
DEMO_MODE=false

# --- Keys -------------------------------------------------------------
# Deepgram (speech-to-text), required in live mode: https://console.deepgram.com
DEEPGRAM_API_KEY=
# Groq (scam analysis), needed from Phase 2: https://console.groq.com/keys
# The free tier is limited (check console.groq.com/settings/limits), so
# analysis only runs when there is new speech.
GROQ_API_KEY=

# --- Models -----------------------------------------------------------
DEEPGRAM_MODEL=nova-3
# Model for the live scam check (supports strict JSON output). The 20b model
# was faster on paper but missed calm, polite scams; 120b at low reasoning
# caught them every time and still answers in under a second.
LIVE_MODEL=openai/gpt-oss-120b

# --- Tuning (used from Phase 2) ---------------------------------------
# Risk 0-100: below YELLOW is GREEN, YELLOW..RED is YELLOW, at or above RED is RED
RISK_YELLOW_THRESHOLD=40
RISK_RED_THRESHOLD=70
# Scam checks run only after new speech, at least this many seconds apart
ANALYSIS_INTERVAL_SECONDS=4
# ...and at most this many in any 60 seconds. Groq's free tier allows about
# 8,000 tokens a minute and a check is about 1,350, so 5 leaves some room.
# The start of a call is checked every 4 s; a long call settles to about 1 every 12 s.
CHECKS_PER_MINUTE=5
# How much recent speech the analyser sees, in seconds
WINDOW_SECONDS=30

# --- Server -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
