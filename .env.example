# Copy this file to .env and fill in your keys:  cp .env.example .env
# .env is git-ignored; never commit real keys.

# --- Mode -------------------------------------------------------------
# true  = demo mode: replays recorded calls, needs no keys (arrives in Phase 2)
# false = live mode: real microphone + Deepgram transcription
DEMO_MODE=false

# --- Keys -------------------------------------------------------------
# Deepgram (speech-to-text), required in live mode: https://console.deepgram.com
DEEPGRAM_API_KEY=
# Groq (scam analysis), needed from Phase 2: https://console.groq.com/keys
# The free tier is limited (check console.groq.com/settings/limits), so
# analysis only runs when there is new speech.
GROQ_API_KEY=

# --- Models -----------------------------------------------------------
DEEPGRAM_MODEL=nova-3
# Fast model for live scoring every few seconds (supports strict JSON output)
LIVE_MODEL=openai/gpt-oss-20b
# Stronger model for the one-off post-call summary
SUMMARY_MODEL=openai/gpt-oss-120b

# --- Tuning (used from Phase 2) ---------------------------------------
# Risk 0-100: below YELLOW is GREEN, YELLOW..RED is YELLOW, at or above RED is RED
RISK_YELLOW_THRESHOLD=40
RISK_RED_THRESHOLD=70
# How often the transcript window is sent to the live model, in seconds
ANALYSIS_INTERVAL_SECONDS=4
# How much recent speech the analyser sees, in seconds
WINDOW_SECONDS=30

# --- Server -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
